# raw data is NEVER committed — re-download with scripts/fetch_data.sh
data/raw/
*.tar.gz
*.nc
# large processed tensors stay out too; keep only small demo artifacts
data/processed/*/samples.npz
data/processed/kaggle_insat3d_manifest.csv
__pycache__/
*.pyc
.venv/
.venv-train/
models/*.pt
models/*.onnx
# Reviewed demo baselines are intentionally versioned by digest; other
# training outputs remain ignored until explicitly promoted.
!models/cyclonet_insat3d_legacy.onnx
!models/cyclonet_insat3d_trained.onnx

# Frontend/build and local tooling
web/node_modules/
web/dist/
*.tsbuildinfo
.env
.env.*
!.env.example
.pytest_cache/
.ruff_cache/
